# ---- MQTT broker (HiveMQ Cloud) ----
MQTT_URL=mqtts://<your-cluster>.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=dashboard-reader        # create a separate credential in HiveMQ Access Management, subscribe-only
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=devices

# ---- Google Maps ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=            # required for Advanced Markers + cloud styling
DEFAULT_MAP_CENTER=6.5244,3.3792      # Lagos; used when no device has a fix

# ---- Dashboard auth ----
DASHBOARD_PASSWORD=
SESSION_SECRET=                       # 32+ random chars, e.g. `openssl rand -base64 48`

# ---- Storage ----
DATABASE_PATH=./data/axiometer.db
RETENTION_DAYS=30

# ---- Simulator only (optional): a device credential with publish rights ----
# SIM_MQTT_USERNAME=
# SIM_MQTT_PASSWORD=
